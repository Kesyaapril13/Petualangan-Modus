# Salin file ini menjadi .env lalu isi SALAH SATU API Key. JANGAN upload .env ke GitHub.
# Pilihan 1: DeepSeek resmi (perlu isi saldo)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Pilihan 2: DeepSeek GRATIS lewat OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash:free
